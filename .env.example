# Copy to .env and adjust as needed. Loaded by the backend from Phase 1 onward.
# ---- Phase 1: operational database (docker compose service `postgres`)
DATABASE_URL=postgres://oms:oms@localhost:5432/oms
PGHOST=localhost
PGPORT=5432
PGUSER=oms
PGPASSWORD=oms
PGDATABASE=oms

# ---- Added in later Phase 1 steps
REDIS_URL=redis://localhost:6379
TIMESCALE_URL=postgres://oms:oms@localhost:5433/telemetry
KAFKA_BROKERS=localhost:9092
