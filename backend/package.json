{
  "name": "oms-backend",
  "version": "1.0.0",
  "description": "Outage Management System — control-room backend (REST + WebSocket, embedded SQL)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/infra/seed.js",
    "seed:oms03": "node src/infra/seed.js --force --scenario=oms03",
    "test": "node --test src/domain/rebalance.test.js src/domain/geofence.test.js src/domain/photos.test.js && node src/selftest.js && node src/selftest-oms01.js && node src/selftest-oms03.js && node src/selftest-jobs.js && node src/selftest-workorders.js && node src/selftest-crewfeatures.js",
    "test:oms01": "node src/selftest-oms01.js",
    "test:workorders": "node src/selftest-workorders.js",
    "test:crewfeatures": "node src/selftest-crewfeatures.js",
    "test:feederkpi": "node src/selftest-feederkpi.js",
    "test:oms03": "node --test src/domain/rebalance.test.js",
    "test:oms03:db": "node src/selftest-oms03.js",
    "telemetry:load": "node scripts/load-telemetry.mjs",
    "telemetry:convert": "node scripts/convert-feeder-snapshot.mjs",
    "tiles:fetch": "node scripts/fetch-tiles.mjs",
    "map:test-server": "node map-test-server/server.mjs",
    "keycloak:mobile": "node scripts/setup-mobile-keycloak.mjs",
    "keycloak:session-limit": "node scripts/setup-crew-session-limit.mjs",
    "roads:build": "node scripts/build-road-graph.mjs",
    "photos:export": "node scripts/export-photos.mjs",
    "test-jobs": "node scripts/test-jobs.mjs",
    "test-jobs:remove": "node scripts/test-jobs.mjs --remove"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "kafkajs": "^2.2.4",
    "nanoid": "^5.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.2",
    "pg-promise": "^11",
    "redis": "^6.2.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.5",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "osm-pbf-parser": "^2.3.0"
  }
  
}
