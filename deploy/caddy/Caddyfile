# HTTPS front door for the OMS, separate from any other Caddy on the server.
# One origin serves both the web app and the Keycloak login pages, so the browser never mixes http and https.
{
	# Browsers send no SNI for a bare IP address, so say which certificate to use.
	default_sni {$OMS_HOST}
	skip_install_trust
	auto_https disable_redirects
}

https://{$OMS_HOST}:8443 {
	tls internal

	# Keycloak's master realm (its own admin login) and admin console are not served here.
	@kcmaster path /realms/master /realms/master/*
	respond @kcmaster 404

	# What the oms-upcl login pages need. An allowlist, not /realms/*: a path such as /realms/master;x=1/ (a ';'
	# path parameter) slips past the 404 above but Keycloak still serves it as the master realm.
	@keycloak path /realms/oms-upcl /realms/oms-upcl/* /resources/* /js/* /robots.txt
	reverse_proxy @keycloak keycloak:8080

	reverse_proxy oms-web:80
}
